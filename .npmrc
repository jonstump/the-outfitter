# Governing: SPEC-0002 REQ "Toolchain Enforcement at Install Time".
# engine-strict=true is the enforcement point: installs fail (non-zero) on a Node outside
# root package.json "engines.node" instead of warning. Fallback when a dependency's own
# engines field causes spurious failures: replace with a preinstall guard scoped to the
# root range (see spec scenario 3).
engine-strict=true
