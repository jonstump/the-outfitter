node_modules/
client/dist/
server/data/db.json
server/data/db.test.json
# server/src/index.test.js boots the real entry point as a child process, which needs a
# store of its own: it runs with NODE_ENV=production and would otherwise write the
# developer's real db.json.
server/data/db.cors-test.json
# The same file boots a SECOND instance for issue #199 — one configured as if a proxy were
# in front, one as if nothing were — and two processes must not share a store.
server/data/db.direct-test.json
.DS_Store
*.log
.sdd/
# Project-local qmd index. Deliberately local rather than the shared ~/.cache/qmd one:
# a machine-wide index puts every indexed repo in reach of one unscoped `qmd query`,
# including private ones. Scoping with `-c` is a convention; this is a boundary.
# Rebuild with /sdd:index — it is a derived artifact, and index.sqlite is binary.
.qmd/

# Local environment overrides (copy of .env.example); never commit real values
.env
# Local Claude Code artifacts. worktrees/ holds /sdd:work scratch checkouts;
# settings.local.json is the documented per-developer override; launch.json encodes
# machine-specific ports and whether to start or attach to a dev server.
# A shared launch.json could be committed later by removing that line.
.claude/worktrees/
.claude/launch.json
.claude/settings.local.json
